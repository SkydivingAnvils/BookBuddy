# Required: book cover identification and recommendations
ANTHROPIC_API_KEY=

# Optional: higher Google Books rate limits
GOOGLE_BOOKS_API_KEY=

# Optional: enables Hardcover as a metadata source (https://hardcover.app/account/api)
HARDCOVER_API_KEY=

# Optional: automatic database backups to ./data/backups (0 turns them off)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
